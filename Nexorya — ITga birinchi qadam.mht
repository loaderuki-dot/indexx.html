@charset "utf-8";

* { box-sizing: border-box; }

html { scroll-behavior: smooth; scroll-padding-top: 110px; }

body { margin: 0px; background: rgb(9, 13, 24); color: rgb(237, 242, 255); font: 16px / 1.7 Arial, sans-serif; }

a { color: rgb(128, 218, 206); text-decoration: none; }

button { font: inherit; cursor: pointer; }

.wrap { width: min(1080px, 91%); margin: auto; }

header { position: sticky; top: 0px; background: rgba(9, 13, 24, 0.96); z-index: 5; border-bottom: 1px solid rgba(255, 255, 255, 0.094); }

nav { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 18px 0px; }

.logo { color: white; font-size: 25px; font-weight: bold; }

.logo span, h1 span { color: rgb(102, 227, 212); }

.links, .actions { display: flex; gap: 14px; flex-wrap: wrap; }

.links { font-size: 14px; }

.actions { margin-top: 20px; align-items: center; }

section { padding: 50px 0px; }

.hero { padding: 75px 0px; background: radial-gradient(at 80% 10%, rgba(35, 65, 105, 0.333), transparent 60%); }

h1 { font-size: clamp(38px, 6vw, 65px); line-height: 1.15; max-width: 800px; }

h2 { font-size: 30px; }

p { color: rgb(165, 176, 198); }

.badge, .tag { color: rgb(102, 227, 212); font-size: 13px; }

.badge { border: 1px solid rgba(102, 227, 212, 0.267); border-radius: 25px; padding: 7px 14px; display: inline-block; }

.btn, button { display: inline-block; background: rgb(23, 36, 58); color: rgb(237, 242, 255); border: 1px solid rgba(255, 255, 255, 0.125); border-radius: 12px; padding: 11px 17px; }

.primary { background: linear-gradient(120deg, rgb(128, 167, 255), rgb(102, 227, 212)); color: rgb(7, 18, 28); font-weight: bold; }

.grid { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 22px; }

.three { grid-template-columns: repeat(3, minmax(0px, 1fr)); }

.card { min-width: 0px; background: rgb(17, 24, 39); border: 1px solid rgba(255, 255, 255, 0.082); border-radius: 20px; overflow: hidden; }

.pad { padding: 23px; }

.frame { position: relative; aspect-ratio: 16 / 9; background: rgb(0, 0, 0); }

.frame iframe { position: absolute; inset: 0px; width: 100%; height: 100%; border: 0px; }

.small { font-size: 13px; }

.quote { font-size: 24px; color: rgb(237, 242, 255); }

.timer { font-size: 64px; color: rgb(102, 227, 212); font-variant-numeric: tabular-nums; }

.check { display: block; padding: 12px 0px; border-bottom: 1px solid rgba(255, 255, 255, 0.07); }

input { accent-color: rgb(102, 227, 212); margin-right: 10px; }

button[aria-pressed="true"] { border-color: rgb(102, 227, 212); color: rgb(102, 227, 212); }

.stats { margin-top: 28px; }

.stats h3 { margin: 0px; }

.stats .number { font-size: 24px; color: rgb(102, 227, 212); }

.notice { border-left: 3px solid rgb(232, 197, 128); padding-left: 15px; }

footer { padding: 25px 0px; border-top: 1px solid rgba(255, 255, 255, 0.094); }

:focus-visible { outline: rgb(102, 227, 212) solid 3px; outline-offset: 4px; }

@media (max-width: 700px) {
  .grid, .three { grid-template-columns: 1fr; }
  nav { align-items: flex-start; flex-direction: column; gap: 8px; }
  .links { font-size: 12px; }
  section { padding: 35px 0px; }
  .hero { padding: 45px 0px; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
}
