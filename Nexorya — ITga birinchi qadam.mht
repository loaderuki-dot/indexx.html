.dialog.modern-dialog-layout.dialog-fullscreen { border-radius: 0px; }

.dialog-container.dialog-fullscreen { margin: 0px; }

c3-toast { display: block; position: fixed; z-index: 5; left: 0px; right: 0px; bottom: 0px; box-sizing: border-box; padding: 14px 24px; font-size: 1.4rem; color: var(--t285d1cbb17921f77); background: var(--t1405e70a39276293); will-change: transform; margin-bottom: -100%; }

